# Copy this file to ".env" and edit the values.

# --- Flask ---
SECRET_KEY=replace-with-a-long-random-string

# --- MySQL ---
DB_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=2926
MYSQL_DB=hospital_analytics

# --- Accounts created by seed.py (change before sharing the app) ---
ADMIN_EMAIL=admin@hospital.local
ADMIN_PASSWORD=Admin@12345
DEMO_USER_EMAIL=user@hospital.local
DEMO_USER_PASSWORD=User@12345

# Show the "Try a demo account" panel on the login page (1 = show, 0 = hide)
SHOW_DEMO_HINT=1

# Quick try-out without MySQL: set DB_BACKEND=sqlite (data is stored in instance/hospital.db)
